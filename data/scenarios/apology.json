{
  "id": "apology",
  "label_en": "Apologize",
  "label_ja": "お詫び",
  "langs": ["ja"],
  "fields": [
    { "key": "sender_name", "label": "Your family name", "kind": "text", "required": true, "show_if": { "channel": "email" } },
    { "key": "recipient_name", "label": "Their family name", "kind": "text", "required": true, "show_if": { "channel": "email" } },
    { "key": "client_company", "label": "Client's company (Japanese)", "kind": "text", "required": true, "show_if": { "recipient": "client", "channel": "email" } },
    { "key": "sender_company", "label": "Your company (Japanese)", "kind": "text", "required": true, "show_if": { "recipient": "client", "channel": "email" } },
    { "key": "event", "label": "Course name (Japanese)", "kind": "text", "required": true, "show_if": { "recipient": "professor", "channel": "email" } },
    { "key": "incident", "label": "What happened (Japanese, e.g. 資料の送付が遅れたこと)", "kind": "text", "required": true },
    { "key": "next_step", "label": "Next action (Japanese, e.g. 資料を送り直す)", "kind": "text", "required": true }
  ],
  "slot_order": ["subject", "address", "greeting", "self_intro", "core", "closing", "signature"],
  "slots": {
    "subject": [{ "id": "subject.apology", "ja": "【お詫び】{incident}について" }],
    "self_intro": [{ "id": "self_intro.apology.chat", "when": { "channel": "chat" }, "skip": true }],
    "core": [
      { "id": "core.apology.formal", "when": { "politeness": "formal" }, "ja": "{incident}につきまして、深くお詫び申し上げます。今後の対応として、まず{next_step}ことといたします。" },
      { "id": "core.apology.polite", "when": { "politeness": "polite" }, "ja": "{incident}について、申し訳ありません。まずは{next_step}予定です。" },
      { "id": "core.apology.casual", "ja": "{incident}について、すみません！まずは{next_step}つもりです。" }
    ]
  }
}
