{
  "id": "lateness",
  "label_en": "Running late",
  "label_ja": "遅刻の連絡",
  "langs": ["ja"],
  "fields": [
    { "key": "sender_name", "label": "Your family name", "kind": "text", "required": true, "show_if": { "channel": "email" } },
    { "key": "recipient_name", "label": "Their family name", "kind": "text", "required": true, "show_if": { "channel": "email" } },
    { "key": "reason", "label": "Reason", "kind": "select", "options": ["train_delay", "illness", "oversleep", "other"], "required": true },
    { "key": "reason_other", "label": "Other reason (Japanese)", "kind": "text", "required": true, "show_if": { "reason": "other" } },
    { "key": "minutes", "label": "Minutes late", "kind": "number", "required": true },
    { "key": "event", "label": "Class / shift / meeting", "kind": "text" },
    { "key": "ask_handouts", "label": "Ask for handouts", "kind": "toggle", "show_if": { "recipient": "professor" } }
  ],
  "slot_order": ["subject", "address", "greeting", "self_intro", "core", "apology", "request", "signature"],
  "phrases": {
    "reason_phrase": { "by": "reason", "map": {
      "train_delay": { "formal": "電車遅延", "casual": "電車の遅れ" },
      "illness": "体調不良",
      "oversleep": { "formal": "私の不注意", "casual": "寝坊" },
      "other": "{reason_other}"
    } }
  },
  "slots": {
    "subject": [{ "id": "subject.late", "when": {}, "ja": "遅刻のご連絡" }],
    "core": [
      { "id": "core.late.formal", "when": { "politeness": ["formal", "polite"] }, "ja": "本日、{reason_phrase}のため、{minutes}分ほど遅れて{verb:到着する}。" },
      { "id": "core.late.casual", "when": {}, "ja": "{reason_phrase}で{minutes}分ほど遅れます。" }
    ],
    "request": [
      { "id": "request.handouts", "when": { "recipient": "professor", "ask_handouts": "true" }, "ja": "恐れ入りますが、配布資料を後ほどいただけますか。" },
      { "id": "request.none", "when": {}, "skip": true }
    ]
  }
}
